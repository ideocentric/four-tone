# ---------------------------------------------------------------------------
# OS
# ---------------------------------------------------------------------------
.DS_Store
.AppleDouble
.LSOverride
._*
Thumbs.db
desktop.ini

# ---------------------------------------------------------------------------
# JetBrains / CLion
# ---------------------------------------------------------------------------
.idea/
*.iml
cmake-build-*/
# CMake files generated by `pio project init --ide clion` (older plugin flow)
CMakeListsPrivate.txt
CMakeListsUser.txt

# ---------------------------------------------------------------------------
# PlatformIO
# ---------------------------------------------------------------------------
.pio/
.pioenvs/
.piolibdeps/
.clang_complete
.gcc-flags.json
.ccls
compile_commands.json

# VS Code files PlatformIO generates if the project is ever opened there
.vscode/.browse.c_cpp.db*
.vscode/c_cpp_properties.json
.vscode/launch.json
.vscode/ipch

# ---------------------------------------------------------------------------
# Arduino IDE / arduino-cli build output
# ---------------------------------------------------------------------------
build/
*.elf
*.hex
*.eep
*.bin
*.map
*.o
*.a

# ---------------------------------------------------------------------------
# KiCad
# ---------------------------------------------------------------------------
# Backups and autosaves
*-backups/
*.bak
*.bck
*.kicad_pcb-bak
*.kicad_sch-bak
*-bak
*~
_autosave-*
\#auto_saved_files\#
# Lock files held while a design is open
*.lck
~*.lck
# Per-user UI state (layer visibility, open sheets); not part of the design
*.kicad_prl
# Caches
fp-info-cache
*.cache
# Legacy KiCad 5 files
*.sch-bak
*-save.pro
*-save.kicad_pcb
# Scratch exports; release outputs go under hardware/pcb/fabrication/<rev>/
/hardware/pcb/*.gbr
/hardware/pcb/*.drl
/hardware/pcb/*.zip
/hardware/pcb/*.pos
/hardware/pcb/*-bom.csv

# ---------------------------------------------------------------------------
# 3D printing / mechanical
# ---------------------------------------------------------------------------
# Sliced output is printer-specific; regenerate from the slicer project
*.gcode
*.bgcode
*.gco
*.ufp
# Vendor product images kept locally for reference. They are the seller's
# copyrighted photos with no redistribution license, so they stay out of git.
/mechanical/cad/specifications/

# CAD autosave, backup and lock files
*.FCBak
*.FCStd1
*.FCStd2
*.f3d.lock
~$*
*.SLDPRT.bak

# ---------------------------------------------------------------------------
# Python (PlatformIO scripts, helper tooling)
# ---------------------------------------------------------------------------
.venv/
__pycache__/
*.pyc

# ---------------------------------------------------------------------------
# Secrets (never commit)
# ---------------------------------------------------------------------------
.env
.env.*
